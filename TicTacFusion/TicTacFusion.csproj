<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <ApplicationTitle>Tic Tac Fusion</ApplicationTitle>
    <AssemblyName>TicTacFusion</AssemblyName>
    <RootNamespace>TicTacFusion</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Janitha Gamage</Authors>
    <Product>Tic Tac Fusion - Next-Gen PC Edition</Product>
    <Description>A modern, visually stunning Tic Tac Fusion game for PC with advanced AI, customizable themes, and procedural audio.</Description>
  </PropertyGroup>

</Project>

